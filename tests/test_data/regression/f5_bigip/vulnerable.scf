#TMSH-VERSION: 16.1.5
sys global-settings {
    hostname bigip-a.example.test
    console-inactivity-timeout 0
}
sys sshd {
    login enabled
    allow none
    inactivity-timeout 0
}
sys httpd {
    allow { all }
    redirect-http-to-https disabled
    ssl-protocol "all -SSLv2 -SSLv3"
    ssl-ciphersuite ECDHE-RSA-AES128-GCM-SHA256:DES-CBC3-SHA
}
sys snmp {
    allowed-addresses { 0.0.0.0/0 }
    communities {
        /Common/comm-public {
            community-name public
            access rw
            source default
        }
    }
    users {
        /Common/monitor {
            username monitor
            security-level no-auth-no-privacy
            access ro
        }
    }
}
cli global-settings {
    audit disabled
    idle-timeout disabled
}
auth password-policy {
    policy-enforcement disabled
    max-login-failures 0
}
auth source {
    type radius
    fallback false
}
auth radius /Common/system-auth {
    servers none
}
auth user /Common/audit {
    password ExampleExposedPassword
}
sys syslog {
    remote-servers none
}
auth user /Common/admin {
    encrypted-password $6$synthetic-private-material
}
ltm profile client-ssl /Common/unsafe_ssl {
    mode enabled
    allow-non-ssl enabled
}
ltm virtual /Common/application {
    enabled
    destination /Common/192.0.2.100:443
    profiles { /Common/unsafe_ssl { context clientside } }
}
sys ntp {
    servers { 192.0.2.123 }
    timezone UTC
}
net self external-self {
    address 192.0.2.1/24
    allow-service all
    vlan external
}
net ipsec ike-peer /Common/branch {
    mode aggressive
    phase1-auth-method pre-shared-key
    remote-address 198.51.100.9
}
